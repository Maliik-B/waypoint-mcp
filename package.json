{
  "name": "waypoint-mcp",
  "version": "1.0.0",
  "description": "MCP server that helps teachers differentiate instruction for students with Individualized Education Programs (IEPs). Given a lesson and a student's IEP, provides Claude with structured context to produce specific, actionable instructional modifications.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "iep",
    "special-education",
    "differentiated-instruction",
    "accommodations",
    "claude"
  ],
  "author": "Maliik Bryan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maliik-B/waypoint-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
